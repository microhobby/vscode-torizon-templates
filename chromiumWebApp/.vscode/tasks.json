{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "deploy-torizon-arm64",
            "detail": "Wait for Chromium CDP, navigate to app, signal VSCode to attach",
            "hide": true,
            "command": "until curl -sf --max-time 2 http://localhost:${config:torizon_debug_ssh_port}/json/version >/dev/null 2>&1; do sleep 1; done; echo 'CDP ready'; sleep 2; TARGET_WS=$(curl -s http://localhost:${config:torizon_debug_ssh_port}/json/list | python3 -c \"import json,sys; targets=json.load(sys.stdin); print(next(t['webSocketDebuggerUrl'] for t in targets if t['type']=='page'))\"); wscat -c \"$TARGET_WS\" --no-color -x '{\"id\":1,\"method\":\"Page.navigate\",\"params\":{\"url\":\"file://${config:torizon_app_root}/src/index.html\"}}' -w 1 >/dev/null 2>&1 || true",
            "type": "shell",
            "args": [],
            "dependsOn": [
                "start-ssh-tunnel",
                "validate-settings",
                "validate-arch-arm64",
                "copy-docker-compose",
                "pre-cleanup",
                "build-container-torizon-debug-arm64",
                "push-container-torizon-debug-arm64",
                "pull-container-torizon-debug",
                "run-container-torizon-debug"
            ],
            "dependsOrder": "sequence",
            "isBackground": true,
            "problemMatcher": [
                {
                    "pattern": [
                        {
                        "regexp": ".",
                        "file": 1,
                        "location": 2,
                        "message": 3
                        }
                    ],
                    "background": {
                        "activeOnStart": true,
                        "beginsPattern": ".",
                        "endsPattern": "CDP ready"
                    }
                }
            ],
            "icon": {
                "id": "debug-start",
                "color": "terminal.ansiGreen"
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": true,
                "panel": "shared",
                "group": "build-execution"
            }
        },
