        {
            "label": "deploy-torizon-amd64",
            "detail": "Wait for Chromium CDP, navigate to app, signal VSCode to attach",
            "hide": true,
            "command": "until curl -sf --max-time 2 http://localhost:${config:torizon_debug_ssh_port}/json/version >/dev/null 2>&1; do sleep 1; done; echo 'CDP ready'; sleep 2; TARGET_WS=$(curl -s http://localhost:${config:torizon_debug_ssh_port}/json/list | python3 -c \"import json,sys; targets=json.load(sys.stdin); print(next(t['webSocketDebuggerUrl'] for t in targets if t['type']=='page'))\"); wscat -c \"$TARGET_WS\" --no-color -x '{\"id\":1,\"method\":\"Page.navigate\",\"params\":{\"url\":\"file://${config:torizon_app_root}/src/index.html\"}}' -w 1 >/dev/null 2>&1 || true",
            "type": "shell",
            "args": [],
            "dependsOn": [
                "start-ssh-tunnel",
                "validate-settings",
                "validate-arch-amd64",
                "copy-docker-compose",
                "pre-cleanup",
                "build-container-torizon-debug-amd64",
                "push-container-torizon-debug-amd64",
                "pull-container-torizon-debug",
                "run-container-torizon-debug"
            ],
            "dependsOrder": "sequence",
            "isBackground": true,
            "problemMatcher": [
                {
                    "pattern": [
                        {
                        "regexp": ".",
                        "file": 1,
                        "location": 2,
                        "message": 3
                        }
                    ],
                    "background": {
                        "activeOnStart": true,
                        "beginsPattern": ".",
                        "endsPattern": "CDP ready"
                    }
                }
            ],
            "icon": {
                "id": "debug-start",
                "color": "terminal.ansiGreen"
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": true,
                "panel": "shared",
                "group": "build-execution"
            }
        },
        {
            "label": "start-ssh-tunnel",
            "hide": true,
            "type": "process",
            "command": "sshpass",
            "args": [
                "-p", "${config:torizon_psswd}",
                "ssh",
                "-p", "${config:torizon_ssh_port}",
                "-N",
                "-o", "UserKnownHostsFile=/dev/null",
                "-o", "StrictHostKeyChecking=no",
                "-o", "PubkeyAuthentication=no",
                "-o", "ExitOnForwardFailure=yes",
                "-L", "${config:torizon_debug_ssh_port}:localhost:${config:torizon_debug_ssh_port}",
                "${config:torizon_run_as}@${config:torizon_ip}"
            ],
            "isBackground": true,
            "problemMatcher": {
                "pattern": [
                    {
                    "regexp": ".",
                    "file": 1,
                    "location": 2,
                    "message": 3
                    }
                ],
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": ".",
                    "endsPattern": "."
                }
            },
            "dependsOrder": "sequence",
            "dependsOn": [
                "stop-ssh-tunnel"
            ],
            "presentation": {
                "echo": true,
                "reveal": "silent",
                "focus": false,
                "panel": "shared",
                "group": "debug-tunnel"
            }
        },
        {
            "label": "stop-ssh-tunnel",
            "hide": true,
            "type": "shell",
            "command": "bash",
            "args": [
                "-c",
                "pkill -f '${config:torizon_debug_ssh_port}:localhost:${config:torizon_debug_ssh_port}' || true"
            ]
        }
    ],
"inputs": []
}
